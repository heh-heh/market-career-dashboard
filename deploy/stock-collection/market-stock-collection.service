[Unit]
Description=Market stock collection tick/history scheduler (pause controlled)
Requires=market-stock-token-broker.service
After=market-stock-token-broker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=heh-heh
Group=heh-heh
WorkingDirectory=/srv/apps/_deploy/stock-collection/current
ExecStart=/usr/bin/bash /srv/apps/_deploy/stock-collection/bin/run-scheduler.sh
Restart=on-failure
RestartSec=10
UMask=0077
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/ai-data/stock-collection
MemoryMax=2G
CPUQuota=150%
TasksMax=96
LimitNOFILE=4096
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
