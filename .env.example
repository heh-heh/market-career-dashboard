# Market Career Dashboard server environment
# Copy to .env on EC2 and set real values there. Never commit .env.

ADMIN_PASSWORD=
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
LIVE_ARM_PHRASE=

# Safety limits
MAX_ORDER_KRW=100000
MAX_DAILY_LOSS_KRW=50000
MAX_ORDER_USD=100
MAX_DAILY_LOSS_USD=50

# US auto-trader / V3 multi-strategy scanner
AUTO_SCAN_INTERVAL_SEC=30
AUTO_SCAN_UNIVERSE_SIZE=20
AUTO_SCAN_TOTAL_SYMBOLS=40
AUTO_MAX_CANDIDATES=10
AUTO_MIN_FINAL_SCORE=55
AUTO_ENTRY_SESSIONS=REGULAR
AUTO_US_MIN_TRADING_VOLUME=100000
AUTO_US_MIN_PRICE=5
AUTO_US_MAX_PRICE=1000
AUTO_SEED_SYMBOLS=NVDA,AMD,MU,INTC,AVGO,MRVL,AMAT,LRCX,KLAC,TSM,SOXX,SMH,SOXL,SOXS,AAPL,MSFT,META,AMZN,GOOGL,TSLA,PLTR,SPY,QQQ,IWM,TQQQ,SQQQ

# Legacy exit values retained for dashboard compatibility.
AUTO_TAKE_PROFIT_PCT=1.5
AUTO_STOP_LOSS_PCT=1.0

# Optional. Leave unset when the Toss account API returns exactly one account.
TOSS_ACCOUNT_SEQ=

# Independent USD paper account. Defaults OFF until authenticated admin start.
# This never enables live mode or requires ARM. Persist outside Git checkout.
SIMPLE_PAPER_DATA_DIR=/var/lib/market-career-dashboard/paper_simple_v1
SIMPLE_PAPER_INITIAL_CASH_USD=10000
SIMPLE_PAPER_ORDER_USD=100
SIMPLE_SLIPPAGE_BPS=2
SIMPLE_MIN_PRICE=5
SIMPLE_MIN_DAY_CHANGE_PCT=3
SIMPLE_MIN_TRADING_VOLUME=50000
SIMPLE_MIN_TRADING_AMOUNT_USD=500000
SIMPLE_MAX_CANDIDATES=20
SIMPLE_IMPULSE_WINDOW_MINUTES=10
SIMPLE_MIN_IMPULSE_PCT=1
SIMPLE_PULLBACK_MIN_PCT=0.5
SIMPLE_PULLBACK_MAX_PCT=4
SIMPLE_HARD_STOP_PCT=1.2
SIMPLE_TRAIL_ACTIVATION_PCT=0.8
SIMPLE_TRAIL_DISTANCE_PCT=0.6
SIMPLE_TIME_STOP_MINUTES=15
SIMPLE_FORCE_EXIT_TIME=15:50
SIMPLE_ENTRY_SESSIONS=DAY,PRE,REGULAR
SIMPLE_EXTENDED_EXIT_BUFFER_MINUTES=2
SIMPLE_MAX_ENTRY_DELAY_SEC=90
# START/END is a declaration, not an inference. Entries stay disabled until
# actual EC2 candle semantics are verified and CONFIRMED is explicitly true.
# Naive timestamps are refused. Quotes must have fresh explicit source times.
SIMPLE_TIMESTAMP_KIND=start
SIMPLE_TIMESTAMP_KIND_CONFIRMED=false
SIMPLE_MAX_QUOTE_AGE_SEC=15
