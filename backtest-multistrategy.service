[Unit]
Description=Market Career Multi-Strategy Backtest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/market-career-dashboard
StateDirectory=market-career-dashboard
StateDirectoryMode=0755
ExecStart=/usr/bin/python3 /home/ubuntu/market-career-dashboard/research/backtest_multistrategy_v1.py --out /var/lib/market-career-dashboard/backtest_multistrategy_v1_result.json --state /var/lib/market-career-dashboard/backtest_multistrategy_v1_state.json --log /var/lib/market-career-dashboard/backtest_multistrategy_v1.log
ExecStartPost=/bin/bash /home/ubuntu/market-career-dashboard/scripts/publish_multistrategy_backtest.sh
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target
